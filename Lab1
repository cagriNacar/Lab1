Console.Write("Enter 3-digit number: ");
int num = int.Parse(Console.ReadLine());

int fd = num / 100;
int md = (num / 10 )% 10;
int ld = num % 10;

int result = fd + md + ld;


Console.WriteLine($"Hundreds: {fd}");
Console.WriteLine($"Tens: {md}");
Console.WriteLine($"Ones: {ld}");
Console.WriteLine($"Sum of digits: {result}");

if(num % 2 == 0) 
   { Console.WriteLine("Number is Even"); }
else
    { Console.WriteLine("Number is Odd"); }

if(fd != ld)
{
    Console.WriteLine("First and last digits are different");
}
else
{
